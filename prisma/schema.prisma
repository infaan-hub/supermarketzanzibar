// Prisma schema for the Supermarket Zanzibar 3D Digital Twin & Inventory System.
// Maps 1:1 to the existing Neon PostgreSQL database (`supermarketzanzibar_*`)
// and extends it additively with Digital Twin, Warehouse, Procurement, Batch,
// and Audit models without modifying or dropping any legacy tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE EXISTING MODELS (Preserved 1:1 with Neon PostgreSQL)
// ============================================================================

model User {
  id                      BigInt    @id @default(autoincrement())
  password                String    @db.VarChar(128)
  lastLogin               DateTime? @map("last_login") @db.Timestamptz(6)
  isSuperuser             Boolean   @default(false) @map("is_superuser")
  username                String    @unique @db.VarChar(150)
  firstName               String    @default("") @map("first_name") @db.VarChar(150)
  lastName                String    @default("") @map("last_name") @db.VarChar(150)
  isStaff                 Boolean   @default(false) @map("is_staff")
  isActive                Boolean   @default(true) @map("is_active")
  dateJoined              DateTime  @default(now()) @map("date_joined") @db.Timestamptz(6)
  phone                   String    @unique @db.VarChar(20)
  fullName                String    @map("full_name") @db.VarChar(255)
  email                   String    @unique @db.VarChar(254)
  address                 String?
  role                    String    @db.VarChar(20)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  profileImageContentType String    @default("") @map("profile_image_content_type") @db.VarChar(100)
  profileImageData        Bytes?    @map("profile_image_data")
  profileImageName        String    @default("") @map("profile_image_name") @db.VarChar(255)
  accessWindowStart       DateTime? @map("access_window_start") @db.Timestamptz(6)
  accessWindowEnd         DateTime? @map("access_window_end") @db.Timestamptz(6)

  supplierProfile  Supplier?
  customerProfile  Customer?
  assignedSales    Sale[]          @relation("AssignedDriver")
  confirmedPayments Payment[]      @relation("ConfirmedBy")
  ownSales         Sale[]          @relation("SaleUser")
  refreshTokens    RefreshToken[]
  stockMovements   StockMovement[] @relation("StockMovementActor")
  purchaseOrders   PurchaseOrder[] @relation("PurchaseOrderCreator")
  goodsReceipts    GoodsReceipt[]  @relation("GoodsReceiptActor")
  auditLogs        AuditLog[]      @relation("AuditActor")

  @@map("supermarketzanzibar_customuser")
}

model Category {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(200)
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("supermarketzanzibar_category")
}

model Supplier {
  id          BigInt   @id @default(autoincrement())
  companyName String   @map("company_name") @db.VarChar(255)
  phone       String   @db.VarChar(20)
  address     String   @default("")
  userId      BigInt   @unique @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products       Product[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@map("supermarketzanzibar_supplier")
}

model Customer {
  id            BigInt   @id @default(autoincrement())
  phone         String   @db.VarChar(20)
  loyaltyPoints Int      @default(0) @map("loyalty_points")
  userId        BigInt   @unique @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales Sale[]

  @@map("supermarketzanzibar_customer")
}

model Product {
  id               BigInt   @id @default(autoincrement())
  name             String   @db.VarChar(255)
  slug             String   @unique @db.VarChar(255)
  sku              String?  @unique @db.VarChar(80)
  brand            String?  @db.VarChar(120)
  unitOfMeasure    String?  @default("each") @map("unit_of_measure") @db.VarChar(32)
  modelAssetId     String?  @map("model_asset_id")
  categoryId       BigInt?  @map("category_id")
  supplierId       BigInt?  @map("supplier_id")
  price            Decimal  @db.Decimal(10, 2)
  costPrice        Decimal  @map("cost_price") @db.Decimal(10, 2)
  quantity         Int      @default(0)
  barcode          String   @unique @db.VarChar(100)
  imageData        Bytes?   @map("image_data")
  imageName        String   @default("") @map("image_name") @db.VarChar(255)
  imageContentType String   @default("") @map("image_content_type") @db.VarChar(100)
  description      String   @default("")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modelAsset         ThreeDAsset?        @relation(fields: [modelAssetId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  saleItems          SaleItem[]
  stockMovements     StockMovement[]
  barcodes           ProductBarcode[]
  shelfPositions     ShelfPosition[]
  inventoryRecords   Inventory[]
  inventoryBatches   InventoryBatch[]
  purchaseOrderItems PurchaseOrderItem[]

  @@map("supermarketzanzibar_product")
}

model ProductBarcode {
  id                 String   @id @default(cuid())
  productId          BigInt   @map("product_id")
  barcode            String   @unique @db.VarChar(100)
  barcodeType        String   @default("code128") @map("barcode_type") @db.VarChar(20)
  unitId             String?  @map("unit_id") @db.VarChar(50)
  quantityMultiplier Decimal  @default(1) @map("quantity_multiplier") @db.Decimal(10, 3)
  isPrimary          Boolean  @default(false) @map("is_primary")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId])
  @@map("supermarketzanzibar_productbarcode")
}

model Sale {
  id                    BigInt   @id @default(autoincrement())
  storeId               String?  @map("store_id")
  idempotencyKey        String?  @unique @map("idempotency_key") @db.VarChar(100)
  customerId            BigInt?  @map("customer_id")
  userId                BigInt?  @map("user_id")
  totalAmount           Decimal  @map("total_amount") @db.Decimal(12, 2)
  tax                   Decimal  @default(0) @db.Decimal(10, 2)
  discount              Decimal  @default(0) @db.Decimal(10, 2)
  finalAmount           Decimal  @map("final_amount") @db.Decimal(12, 2)
  paymentMethod         String   @map("payment_method") @db.VarChar(50)
  paymentConfirmed      Boolean  @default(false) @map("payment_confirmed")
  termsAccepted         Boolean  @default(false) @map("terms_accepted")
  deliveryLocation      String?  @map("delivery_location")
  customerFullName      String   @default("") @map("customer_full_name") @db.VarChar(255)
  customerEmail         String   @default("") @map("customer_email")
  customerPhone         String   @default("") @map("customer_phone") @db.VarChar(20)
  customerAddress       String   @default("") @map("customer_address")
  assignedDriverId      BigInt?  @map("assigned_driver_id")
  status                String   @default("pending_payment") @db.VarChar(30)
  customerHistoryHidden Boolean  @default(false) @map("customer_history_hidden")
  date                  DateTime @default(now()) @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store          Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User?      @relation("SaleUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedDriver User?      @relation("AssignedDriver", fields: [assignedDriverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items          SaleItem[]
  payment        Payment?

  @@map("supermarketzanzibar_sale")
}

model SaleItem {
  id        BigInt   @id @default(autoincrement())
  saleId    BigInt   @map("sale_id")
  productId BigInt   @map("product_id")
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sale           Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product        Product         @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stockMovements StockMovement[]

  @@map("supermarketzanzibar_saleitem")
}

model StockMovement {
  id                    BigInt   @id @default(autoincrement())
  productId             BigInt   @map("product_id")
  saleItemId            BigInt?  @map("sale_item_id")
  sourceLocationId      String?  @map("source_location_id")
  destinationLocationId String?  @map("destination_location_id")
  performedById         BigInt?  @map("performed_by_id")
  reference             String?  @db.VarChar(120)
  notes                 String?
  quantity              Int
  movementType          String   @map("movement_type") @db.VarChar(24)
  date                  DateTime @default(now()) @map("date") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  saleItem    SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  performedBy User?     @relation("StockMovementActor", fields: [performedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([productId, date])
  @@map("supermarketzanzibar_stockmovement")
}

model Payment {
  id                    BigInt   @id @default(autoincrement())
  controlNumber         String   @unique @map("control_number") @db.VarChar(20)
  paymentMethod         String   @default("mobile_money") @map("payment_method") @db.VarChar(50)
  status                String   @default("pending") @db.VarChar(20)
  saleId                BigInt   @unique @map("sale_id")
  confirmedById         BigInt?  @map("confirmed_by_id")
  proofImageData        Bytes?   @map("proof_image_data")
  proofImageName        String   @default("") @map("proof_image_name") @db.VarChar(255)
  proofImageContentType String   @default("") @map("proof_image_content_type") @db.VarChar(100)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sale        Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  confirmedBy User? @relation("ConfirmedBy", fields: [confirmedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("supermarketzanzibar_payment")
}

model RefreshToken {
  id         String    @id @default(uuid())
  jti        String    @unique
  userId     BigInt    @map("user_id")
  issuedAt   DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("refresh_token")
}

// ============================================================================
// PHASE 6 — ADDITIVE 3D DIGITAL TWIN, WAREHOUSE & OPERATIONS MODELS
// ============================================================================

model Store {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(200)
  address   String   @default("")
  location  String   @default("") @db.VarChar(200)
  status    String   @default("active") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  departments        Department[]
  shelves            Shelf[]
  warehouseLocations WarehouseLocation[]
  inventoryRecords   Inventory[]
  inventoryBatches   InventoryBatch[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  sales              Sale[]

  @@map("supermarketzanzibar_store")
}

model Department {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  code        String   @db.VarChar(30)
  name        String   @db.VarChar(150)
  description String   @default("")
  status      String   @default("active") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shelves Shelf[]

  @@unique([storeId, code])
  @@map("supermarketzanzibar_department")
}

model Shelf {
  id           String   @id @default(cuid())
  storeId      String   @map("store_id")
  departmentId String   @map("department_id")
  shelfCode    String   @map("shelf_code") @db.VarChar(40)
  shelfName    String   @map("shelf_name") @db.VarChar(160)
  fixtureKind  String   @default("gondola") @map("fixture_kind") @db.VarChar(40)
  capacity     Int      @default(120)
  status       String   @default("active") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  store      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  department Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  positions  ShelfPosition[]

  @@unique([storeId, shelfCode])
  @@index([departmentId])
  @@map("supermarketzanzibar_shelf")
}

model ShelfPosition {
  id               String   @id @default(cuid())
  shelfId          String   @map("shelf_id")
  productId        BigInt?  @map("product_id")
  positionCode     String   @map("position_code") @db.VarChar(40)
  slotIndex        Int      @default(0) @map("slot_index")
  quantity         Int      @default(0)
  maximumCapacity  Int      @default(24) @map("maximum_capacity")
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  reorderLevel     Int      @default(6) @map("reorder_level")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  shelf   Shelf    @relation(fields: [shelfId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([shelfId, positionCode])
  @@index([productId])
  @@map("supermarketzanzibar_shelfposition")
}

model WarehouseLocation {
  id            String   @id @default(cuid())
  storeId       String   @map("store_id")
  warehouseCode String   @default("WH-MAIN") @map("warehouse_code") @db.VarChar(40)
  zoneCode      String   @map("zone_code") @db.VarChar(30)
  rackCode      String   @map("rack_code") @db.VarChar(30)
  levelCode     String   @map("level_code") @db.VarChar(30)
  positionCode  String   @map("position_code") @db.VarChar(30)
  locationType  String   @default("ambient") @map("location_type") @db.VarChar(30)
  capacity      Int      @default(200)
  status        String   @default("active") @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventoryRecords Inventory[]
  inventoryBatches InventoryBatch[]
  goodsReceipts    GoodsReceipt[]

  @@unique([storeId, warehouseCode, rackCode, levelCode, positionCode])
  @@index([storeId, zoneCode, rackCode])
  @@map("supermarketzanzibar_warehouselocation")
}

model Inventory {
  id                  String   @id @default(cuid())
  productId           BigInt   @map("product_id")
  storeId             String   @map("store_id")
  warehouseLocationId String?  @map("warehouse_location_id")
  quantityOnHand      Int      @default(0) @map("quantity_on_hand")
  reservedQuantity    Int      @default(0) @map("reserved_quantity")
  reorderLevel        Int      @default(10) @map("reorder_level")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  warehouseLocation WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([productId, storeId, warehouseLocationId])
  @@index([storeId, productId])
  @@map("supermarketzanzibar_inventory")
}

model InventoryBatch {
  id                  String    @id @default(cuid())
  productId           BigInt    @map("product_id")
  storeId             String    @map("store_id")
  warehouseLocationId String?   @map("warehouse_location_id")
  batchNumber         String    @map("batch_number") @db.VarChar(80)
  quantity            Int       @default(0)
  costPrice           Decimal   @default(0) @map("cost_price") @db.Decimal(10, 2)
  expiryDate          DateTime? @map("expiry_date") @db.Timestamptz(6)
  status              String    @default("active") @db.VarChar(30)
  receivedAt          DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)

  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  warehouseLocation WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([productId, expiryDate])
  @@index([status, expiryDate])
  @@map("supermarketzanzibar_inventorybatch")
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  orderNumber  String    @unique @map("order_number") @db.VarChar(60)
  storeId      String    @map("store_id")
  supplierId   BigInt    @map("supplier_id")
  status       String    @default("ordered") @db.VarChar(30)
  expectedDate DateTime? @map("expected_date") @db.Timestamptz(6)
  notes        String    @default("")
  totalAmount  Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  createdById  BigInt?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy     User?               @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@index([storeId, status])
  @@map("supermarketzanzibar_purchaseorder")
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  purchaseOrderId  String  @map("purchase_order_id")
  productId        BigInt  @map("product_id")
  orderedQuantity  Int     @map("ordered_quantity")
  receivedQuantity Int     @default(0) @map("received_quantity")
  unitCost         Decimal @map("unit_cost") @db.Decimal(10, 2)
  lineTotal        Decimal @map("line_total") @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product       Product       @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([purchaseOrderId])
  @@map("supermarketzanzibar_purchaseorderitem")
}

model GoodsReceipt {
  id                  String   @id @default(cuid())
  receiptNumber       String   @unique @map("receipt_number") @db.VarChar(60)
  purchaseOrderId     String?  @map("purchase_order_id")
  storeId             String   @map("store_id")
  supplierId          BigInt?  @map("supplier_id")
  warehouseLocationId String?  @map("warehouse_location_id")
  receivedById        BigInt?  @map("received_by_id")
  totalUnits          Int      @default(0) @map("total_units")
  notes               String   @default("")
  receivedAt          DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  purchaseOrder     PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  warehouseLocation WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  receivedBy        User?              @relation("GoodsReceiptActor", fields: [receivedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([storeId, receivedAt])
  @@map("supermarketzanzibar_goodsreceipt")
}

model ThreeDAsset {
  id        String   @id @default(cuid())
  assetKey  String   @unique @map("asset_key") @db.VarChar(120)
  assetName String   @map("asset_name") @db.VarChar(160)
  assetType String   @map("asset_type") @db.VarChar(40)
  filePath  String   @map("file_path") @db.VarChar(255)
  format    String   @default("glb") @db.VarChar(16)
  version   String   @default("1.0.0") @db.VarChar(32)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]
  mappings ThreeDObjectMapping[]

  @@map("supermarketzanzibar_threedasset")
}

model ThreeDObjectMapping {
  id               String   @id @default(cuid())
  assetId          String?  @map("asset_id")
  objectName       String   @unique @map("object_name") @db.VarChar(160)
  objectType       String   @map("object_type") @db.VarChar(40)
  linkedEntityType String   @map("linked_entity_type") @db.VarChar(40)
  linkedEntityId   String   @map("linked_entity_id") @db.VarChar(80)
  posX             Float    @default(0) @map("pos_x")
  posY             Float    @default(0) @map("pos_y")
  posZ             Float    @default(0) @map("pos_z")
  rotX             Float    @default(0) @map("rot_x")
  rotY             Float    @default(0) @map("rot_y")
  rotZ             Float    @default(0) @map("rot_z")
  scaleX           Float    @default(1) @map("scale_x")
  scaleY           Float    @default(1) @map("scale_y")
  scaleZ           Float    @default(1) @map("scale_z")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  asset ThreeDAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([linkedEntityType, linkedEntityId])
  @@map("supermarketzanzibar_threedobjectmapping")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    BigInt?  @map("actor_id")
  action     String   @db.VarChar(80)
