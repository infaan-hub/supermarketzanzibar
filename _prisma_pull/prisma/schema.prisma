generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                              BigInt                                            @id @default(autoincrement())
  password                                        String                                            @db.VarChar(128)
  lastLogin                                       DateTime?                                         @map("last_login") @db.Timestamptz(6)
  isSuperuser                                     Boolean                                           @map("is_superuser")
  username                                        String                                            @unique @db.VarChar(150)
  firstName                                       String                                            @map("first_name") @db.VarChar(150)
  lastName                                        String                                            @map("last_name") @db.VarChar(150)
  isStaff                                         Boolean                                           @map("is_staff")
  isActive                                        Boolean                                           @map("is_active")
  dateJoined                                      DateTime                                          @map("date_joined") @db.Timestamptz(6)
  phone                                           String                                            @unique(map: "supermarketzanzibar_customuser_phone_0cbc454f_uniq") @db.VarChar(20)
  fullName                                        String                                            @map("full_name") @db.VarChar(255)
  email                                           String                                            @unique @db.VarChar(254)
  address                                         String?
  role                                            String                                            @db.VarChar(20)
  createdAt                                       DateTime                                          @map("created_at") @db.Timestamptz(6)
  updatedAt                                       DateTime                                          @updatedAt @map("updated_at") @db.Timestamptz(6)
  profileImageContentType                         String                                            @map("profile_image_content_type") @db.VarChar(100)
  profileImageData                                Bytes?                                            @map("profile_image_data")
  profileImageName                                String                                            @map("profile_image_name") @db.VarChar(255)
  accessWindowEnd                                 DateTime?                                         @map("access_window_end") @db.Timestamptz(6)
  accessWindowStart                               DateTime?                                         @map("access_window_start") @db.Timestamptz(6)
  django_admin_log                                django_admin_log[]
  refreshTokens                                   RefreshToken[]
  customerProfile                                 Customer?
  supermarketzanzibar_customuser_groups           supermarketzanzibar_customuser_groups[]
  supermarketzanzibar_customuser_user_permissions supermarketzanzibar_customuser_user_permissions[]
  confirmedPayments                               Payment[]                                         @relation("ConfirmedBy")
  assignedSales                                   Sale[]                                            @relation("AssignedDriver")
  ownSales                                        Sale[]                                            @relation("SaleUser")
  supplierProfile                                 Supplier?

  @@index([email], map: "supermarketzanzibar_customuser_email_f4a6c81f_like")
  @@index([phone], map: "supermarketzanzibar_customuser_phone_0cbc454f_like")
  @@index([username], map: "supermarketzanzibar_customuser_username_e85cf1dd_like")
  @@map("supermarketzanzibar_customuser")
}

model Category {
  id          BigInt    @id @default(autoincrement())
  name        String    @db.VarChar(200)
  description String
  createdAt   DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products    Product[]

  @@map("supermarketzanzibar_category")
}

model Supplier {
  id          BigInt    @id @default(autoincrement())
  companyName String    @map("company_name") @db.VarChar(255)
  phone       String    @db.VarChar(20)
  address     String
  userId      BigInt    @unique @map("user_id")
  createdAt   DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  products    Product[]
  user        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supermarketzanzibar__user_id_c5cee8a4_fk_supermark")

  @@map("supermarketzanzibar_supplier")
}

model Customer {
  id            BigInt   @id @default(autoincrement())
  phone         String   @db.VarChar(20)
  loyaltyPoints Int      @map("loyalty_points")
  userId        BigInt   @unique @map("user_id")
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supermarketzanzibar__user_id_82ab7cc1_fk_supermark")
  sales         Sale[]

  @@map("supermarketzanzibar_customer")
}

model Product {
  id               BigInt          @id @default(autoincrement())
  name             String          @db.VarChar(255)
  price            Decimal         @db.Decimal(10, 2)
  costPrice        Decimal         @map("cost_price") @db.Decimal(10, 2)
  quantity         Int
  barcode          String          @unique @db.VarChar(100)
  description      String
  isActive         Boolean         @map("is_active")
  createdAt        DateTime        @map("created_at") @db.Timestamptz(6)
  categoryId       BigInt?         @map("category_id")
  supplierId       BigInt?         @map("supplier_id")
  slug             String          @unique @db.VarChar(255)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  imageContentType String          @map("image_content_type") @db.VarChar(100)
  imageData        Bytes?          @map("image_data")
  imageName        String          @map("image_name") @db.VarChar(255)
  category         Category?       @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supermarketzanzibar__category_id_71d01ac7_fk_supermark")
  supplier         Supplier?       @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supermarketzanzibar__supplier_id_911f0de2_fk_supermark")
  saleItems        SaleItem[]
  stockMoves       StockMovement[]

  @@index([barcode], map: "supermarketzanzibar_product_barcode_64f0229c_like")
  @@index([categoryId], map: "supermarketzanzibar_product_category_id_71d01ac7")
  @@index([slug], map: "supermarketzanzibar_product_slug_617cc675_like")
  @@index([supplierId], map: "supermarketzanzibar_product_supplier_id_911f0de2")
  @@map("supermarketzanzibar_product")
}

model Sale {
  id                    BigInt     @id @default(autoincrement())
  totalAmount           Decimal    @map("total_amount") @db.Decimal(12, 2)
  tax                   Decimal    @db.Decimal(10, 2)
  discount              Decimal    @db.Decimal(10, 2)
  finalAmount           Decimal    @map("final_amount") @db.Decimal(12, 2)
  paymentMethod         String     @map("payment_method") @db.VarChar(50)
  date                  DateTime   @db.Timestamptz(6)
  customerId            BigInt?    @map("customer_id")
  userId                BigInt?    @map("user_id")
  createdAt             DateTime   @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignedDriverId      BigInt?    @map("assigned_driver_id")
  delivery_location     String?
  paymentConfirmed      Boolean    @map("payment_confirmed")
  status                String     @db.VarChar(30)
  termsAccepted         Boolean    @map("terms_accepted")
  customerAddress       String     @map("customer_address")
  customerEmail         String     @map("customer_email") @db.VarChar(254)
  customerFullName      String     @map("customer_full_name") @db.VarChar(255)
  customerPhone         String     @map("customer_phone") @db.VarChar(20)
  customerHistoryHidden Boolean    @map("customer_history_hidden")
  payment               Payment?
  assignedDriver        User?      @relation("AssignedDriver", fields: [assignedDriverId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supermarketzanzibar__assigned_driver_id_e9db45cf_fk_supermark")
  customer              Customer?  @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supermarketzanzibar__customer_id_45dd13c2_fk_supermark")
  user                  User?      @relation("SaleUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supermarketzanzibar__user_id_dc057b2e_fk_supermark")
  items                 SaleItem[]

  @@index([assignedDriverId], map: "supermarketzanzibar_sale_assigned_driver_id_e9db45cf")
  @@index([customerId], map: "supermarketzanzibar_sale_customer_id_45dd13c2")
  @@index([userId], map: "supermarketzanzibar_sale_user_id_dc057b2e")
  @@map("supermarketzanzibar_sale")
}

model SaleItem {
  id         BigInt          @id @default(autoincrement())
  quantity   Int
  price      Decimal         @db.Decimal(10, 2)
  total      Decimal         @db.Decimal(12, 2)
  productId  BigInt          @map("product_id")
  saleId     BigInt          @map("sale_id")
  createdAt  DateTime        @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  product    Product         @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supermarketzanzibar__product_id_85f0567e_fk_supermark")
  sale       Sale            @relation(fields: [saleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supermarketzanzibar__sale_id_666af5e6_fk_supermark")
  stockMoves StockMovement[]

  @@index([productId], map: "supermarketzanzibar_saleitem_product_id_85f0567e")
  @@index([saleId], map: "supermarketzanzibar_saleitem_sale_id_666af5e6")
  @@map("supermarketzanzibar_saleitem")
}

model StockMovement {
  id           BigInt    @id @default(autoincrement())
  quantity     Int
  movementType String    @map("movement_type") @db.VarChar(10)
  date         DateTime  @db.Timestamptz(6)
  productId    BigInt    @map("product_id")
  saleItemId   BigInt?   @map("sale_item_id")
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  product      Product   @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supermarketzanzibar__product_id_a9a48eaa_fk_supermark")
  saleItem     SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supermarketzanzibar__sale_item_id_eedd50ca_fk_supermark")

  @@index([productId], map: "supermarketzanzibar_stockmovement_product_id_a9a48eaa")
  @@index([saleItemId], map: "supermarketzanzibar_stockmovement_sale_item_id_eedd50ca")
  @@map("supermarketzanzibar_stockmovement")
}

model Payment {
  id                    BigInt   @id @default(autoincrement())
  controlNumber         String   @unique @map("control_number") @db.VarChar(20)
  paymentMethod         String   @map("payment_method") @db.VarChar(50)
  status                String   @db.VarChar(20)
  createdAt             DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  confirmedById         BigInt?  @map("confirmed_by_id")
  saleId                BigInt   @unique @map("sale_id")
  proofImageContentType String   @map("proof_image_content_type") @db.VarChar(100)
  proofImageData        Bytes?   @map("proof_image_data")
  proofImageName        String   @map("proof_image_name") @db.VarChar(255)
  confirmedBy           User?    @relation("ConfirmedBy", fields: [confirmedById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supermarketzanzibar__confirmed_by_id_9e7345ab_fk_supermark")
  sale                  Sale     @relation(fields: [saleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "supermarketzanzibar__sale_id_4d4eb556_fk_supermark")

  @@index([confirmedById], map: "supermarketzanzibar_payment_confirmed_by_id_9e7345ab")
  @@index([controlNumber], map: "supermarketzanzibar_payment_control_number_e639a4ce_like")
  @@map("supermarketzanzibar_payment")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     BigInt    @map("user_id")
  token_jti  String    @unique
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("refresh_tokens")
}

