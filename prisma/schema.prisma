// Prisma schema for the Supermarket Zanzibar full-stack Next.js application.
// Maps 1:1 to the existing Neon PostgreSQL database (originally created by Django).
// Readable model names are used; physical table/column names are preserved with
// @map so the existing database, records, FKs, and constraints remain untouched.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Custom user (Django `supermarketzanzibar_customuser`).
model User {
  id                      BigInt    @id @default(autoincrement())
  password                String    @db.VarChar(128)
  lastLogin               DateTime? @map("last_login") @db.Timestamptz(6)
  isSuperuser             Boolean   @default(false) @map("is_superuser")
  username                String    @unique @db.VarChar(150)
  firstName               String    @default("") @map("first_name") @db.VarChar(150)
  lastName                String    @default("") @map("last_name") @db.VarChar(150)
  isStaff                 Boolean   @default(false) @map("is_staff")
  isActive                Boolean   @default(true) @map("is_active")
  dateJoined              DateTime  @default(now()) @map("date_joined") @db.Timestamptz(6)
  phone                   String    @unique @db.VarChar(20)
  fullName                String    @map("full_name") @db.VarChar(255)
  email                   String    @unique @db.VarChar(254)
  address                 String?
  role                    String    @db.VarChar(20)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  profileImageContentType String    @default("") @map("profile_image_content_type") @db.VarChar(100)
  profileImageData        Bytes?    @map("profile_image_data")
  profileImageName        String    @default("") @map("profile_image_name") @db.VarChar(255)
  accessWindowStart       DateTime? @map("access_window_start") @db.Timestamptz(6)
  accessWindowEnd         DateTime? @map("access_window_end") @db.Timestamptz(6)

  supplierProfile   Supplier?
  customerProfile   Customer?
  assignedSales     Sale[]         @relation("AssignedDriver")
  confirmedPayments Payment[]      @relation("ConfirmedBy")
  ownSales          Sale[]         @relation("SaleUser")
  refreshTokens     RefreshToken[]

  @@map("supermarketzanzibar_customuser")
}

model Category {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(200)
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("supermarketzanzibar_category")
}

model Supplier {
  id          BigInt   @id @default(autoincrement())
  companyName String   @map("company_name") @db.VarChar(255)
  phone       String   @db.VarChar(20)
  address     String   @default("")
  userId      BigInt   @unique @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products Product[]

  @@map("supermarketzanzibar_supplier")
}

model Customer {
  id            BigInt   @id @default(autoincrement())
  phone         String   @db.VarChar(20)
  loyaltyPoints Int      @default(0) @map("loyalty_points")
  userId        BigInt   @unique @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales Sale[]

  @@map("supermarketzanzibar_customer")
}
model Product {
  id               BigInt   @id @default(autoincrement())
  name             String   @db.VarChar(255)
  slug             String   @unique @db.VarChar(255)
  categoryId       BigInt?  @map("category_id")
  supplierId       BigInt?  @map("supplier_id")
  price            Decimal  @db.Decimal(10, 2)
  costPrice        Decimal  @db.Decimal(10, 2)
  quantity         Int      @default(0)
  barcode          String   @unique @db.VarChar(100)
  imageData        Bytes?   @map("image_data")
  imageName        String   @default("") @map("image_name") @db.VarChar(255)
  imageContentType String   @default("") @map("image_content_type") @db.VarChar(100)
  description      String   @default("")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@map("supermarketzanzibar_product")
}

model Sale {
  id                    BigInt   @id @default(autoincrement())
  customerId            BigInt?  @map("customer_id")
  userId                BigInt?  @map("user_id")
  totalAmount           Decimal  @db.Decimal(12, 2)
  tax                   Decimal  @default(0) @db.Decimal(10, 2)
  discount              Decimal  @default(0) @db.Decimal(10, 2)
  finalAmount           Decimal  @db.Decimal(12, 2)
  paymentMethod         String   @db.VarChar(50)
  paymentConfirmed      Boolean  @default(false) @map("payment_confirmed")
  termsAccepted         Boolean  @default(false) @map("terms_accepted")
  deliveryLocation      String?  @map("delivery_location")
  customerFullName      String   @default("") @map("customer_full_name") @db.VarChar(255)
  customerEmail         String   @default("") @map("customer_email")
  customerPhone         String   @default("") @map("customer_phone") @db.VarChar(20)
  customerAddress       String   @default("") @map("customer_address")
  assignedDriverId      BigInt?  @map("assigned_driver_id")
  status                String   @default("pending_payment") @db.VarChar(30)
  customerHistoryHidden Boolean  @default(false) @map("customer_history_hidden")
  date                  DateTime @default(now()) @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User?           @relation("SaleUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedDriver User?           @relation("AssignedDriver", fields: [assignedDriverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items          SaleItem[]
  payment        Payment?

  @@map("supermarketzanzibar_sale")
}
model SaleItem {
  id        BigInt   @id @default(autoincrement())
  saleId    BigInt   @map("sale_id")
  productId BigInt   @map("product_id")
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sale           Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product        Product         @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stockMovements StockMovement[]

  @@map("supermarketzanzibar_saleitem")
}

model StockMovement {
  id           BigInt   @id @default(autoincrement())
  productId    BigInt   @map("product_id")
  saleItemId   BigInt?  @map("sale_item_id")
  quantity     Int
  movementType String   @map("movement_type") @db.VarChar(10)
  date         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  saleItem SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("supermarketzanzibar_stockmovement")
}

model Payment {
  id                    BigInt    @id @default(autoincrement())
  controlNumber         String    @unique @map("control_number") @db.VarChar(20)
  paymentMethod         String    @default("mobile_money") @map("payment_method") @db.VarChar(50)
  status                String    @default("pending") @db.VarChar(20)
  saleId                BigInt    @unique @map("sale_id")
  confirmedById         BigInt?   @map("confirmed_by_id")
  proofImageData        Bytes?    @map("proof_image_data")
  proofImageName        String    @default("") @map("proof_image_name") @db.VarChar(255)
  proofImageContentType String    @default("") @map("proof_image_content_type") @db.VarChar(100)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sale        Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  confirmedBy User? @relation("ConfirmedBy", fields: [confirmedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("supermarketzanzibar_payment")
}

model RefreshToken {
  id         String    @id @default(uuid())
  jti        String    @unique
  userId     BigInt    @map("user_id")
  issuedAt   DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("refresh_token")
}
