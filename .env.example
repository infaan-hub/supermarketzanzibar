# --- Database -------------------------------------------------------------
# PostgreSQL connection string (Neon in production). Required.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Authentication -------------------------------------------------------
# HMAC secret for JWT signing/verification (HS256, SimpleJWT compatible).
# Use the Django SECRET_KEY value that issued existing tokens.
JWT_SECRET="change-me-long-random-string"
# Google OAuth client id used to verify /api/auth/google/ credentials.
GOOGLE_CLIENT_ID=""

# --- Public application URL ----------------------------------------------
# Set to the Vercel production URL, e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email (optional; console logging when unset) -------------------------
# These are the names read by lib/mail.ts.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@zansupermarket.local"

# --- Tests ---------------------------------------------------------------
# Dedicated test database (never the production database).
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/TEST_DATABASE?sslmode=require"